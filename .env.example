# Variables de Docker (Start-Docker.ps1 / docker compose --env-file). Copia este fichero a .env.production para
# publicar; .env.development lo genera Start-Docker.ps1 la primera vez. Los .env reales nunca se versionan.

# --- Comunes ---
# Volumen con escudos, fotos y vídeos (uno por entorno).
TT_DATA_VOLUME=tercer-tiempo-data
# Puerto de la API en el loopback del equipo (los visitantes entran por el frontal).
TT_API_PORT=8181
# Dirección pública de la web: vuelta de los pagos de Stripe y CORS.
TT_PUBLIC_URL=http://127.0.0.1:8180
# Usuario de /jobs (rol Admin).
TT_ADMIN_USER=diego
TT_ADMIN_PASSWORD=

# --- Desarrollo (compose.development.yaml) ---
# Contraseña del usuario sa del SQL Server del contenedor (8+ caracteres con mayúsculas, minúsculas y números).
TT_SQL_PASSWORD=
TT_SQL_PORT=14333
# TT_SQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest

# --- Publicación (compose.production.yaml) ---
# Cadena de conexión de SQL Server (externo, o Server=db;... con el perfil "database").
TT_DB_CONNECTION=Server=db;Database=TercerTiempo;User Id=sa;Password=<contraseña>;TrustServerCertificate=True;Encrypt=True
# Clave para firmar los JWT: al menos 32 caracteres aleatorios.
TT_JWT_KEY=
# Pasarela de las licencias: mock (sin cobro real) o stripe.
TT_LICENSING_PROVIDER=mock
TT_STRIPE_SECRET_KEY=
TT_STRIPE_WEBHOOK_SECRET=
# Solo con el perfil "database": edición de SQL Server (Express es gratuita para producción).
# TT_SQL_EDITION=Express
