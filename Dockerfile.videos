# Servicio de vídeo (TercerTiempo.Videos): subida, reproducción y compresión de los vídeos, con ffmpeg en la imagen.
# Contexto de build: la raíz de este repositorio.
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src
COPY Directory.Build.props ./
COPY src/TercerTiempo.Videos/TercerTiempo.Videos.csproj src/TercerTiempo.Videos/
COPY src/TercerTiempo.Hosting/TercerTiempo.Hosting.csproj src/TercerTiempo.Hosting/
COPY src/TercerTiempo.Application/TercerTiempo.Application.csproj src/TercerTiempo.Application/
COPY src/TercerTiempo.Domain/TercerTiempo.Domain.csproj src/TercerTiempo.Domain/
COPY src/TercerTiempo.Infrastructure/TercerTiempo.Infrastructure.csproj src/TercerTiempo.Infrastructure/
COPY src/TercerTiempo.Repository/TercerTiempo.Repository.csproj src/TercerTiempo.Repository/
RUN dotnet restore src/TercerTiempo.Videos/TercerTiempo.Videos.csproj
COPY src/ src/
RUN dotnet publish src/TercerTiempo.Videos/TercerTiempo.Videos.csproj --no-restore -c Release -o /out /p:UseAppHost=false

# Etapa opcional, fuera de la imagen por defecto: docker build -f Dockerfile.videos --target test .
# Con ffmpeg instalado se ejecuta también la prueba real de compresión (TT_RUN_FFMPEG_TESTS).
FROM build AS test
RUN apk add --no-cache ffmpeg
COPY tests/ tests/
ENV TT_RUN_FFMPEG_TESTS=1
RUN dotnet test tests/TercerTiempo.Application.Tests/TercerTiempo.Application.Tests.csproj -c Release --filter "FullyQualifiedName~Ffmpeg"

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime
# Cultura es-ES, hora de Europe/Madrid y ffmpeg (con libx264 y AAC) para comprimir.
RUN apk add --no-cache icu-libs icu-data-full tzdata ffmpeg
WORKDIR /app
ENV ASPNETCORE_HTTP_PORTS=8080 \
    ASPNETCORE_ENVIRONMENT=Production \
    ReverseProxy__Enabled=true \
    DOTNET_EnableDiagnostics=0 \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    TZ=Europe/Madrid
COPY --from=build /out/ ./
# Los vídeos (Videos:Directory) viven en el mismo volumen /app/data que la API.
RUN mkdir -p /app/data/videos && chown -R app:app /app/data
USER $APP_UID
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=6 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/media/health || exit 1
ENTRYPOINT ["dotnet", "TercerTiempo.Videos.dll"]
