{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "TercerTiempo",
    "Audience": "TercerTiempo.Web",
    "Key": "",
    "ExpirationMinutes": 720
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "OpenApi": {
    "RoutePrefix": "docs",
    "BasicAuth": {
      "Username": "",
      "Password": ""
    }
  },
  "OfficialSheets": {
    "Enabled": true,
    "Asturfutbol": {
      "BaseUrl": "https://www.asturfutbol.es/pnfg/NPcd/",
      "UserAgent": "TercerTiempo/1.0 (+https://github.com/diegoesp10/TercerTiempo-Back)",
      "RequestDelayMs": 2000,
      "CalendarCode": "1000120",
      "TeamsCode": "1000119",
      "GroundsCode": "1000122",
      "TimeZone": "Europe/Madrid",
      "MatchLength": 90
    }
  },
  "Throttling": {
    "Enabled": true,
    "WindowSeconds": 60,
    "RequestsPerWindow": 300,
    "RequestsPerEndpointPerWindow": 60,
    "BanMinutes": [ 5, 30, 1440 ],
    "MaxBanMinutes": 43200,
    "StrikeMemoryHours": 168,
    "TrustForwardedHeaders": false,
    "ExemptRoutes": [ "/api/teams/{teamId:guid}/crest" ]
  },
  "Crests": {
    "Directory": "data/crests",
    "RefreshDays": 30
  },
  "Videos": {
    "Directory": "data/videos",
    "MaxSizeMb": 2048,
    "DefaultPriceCents": 500,
    "Currency": "EUR",
    "AllowedContentTypes": [ "video/mp4", "video/webm", "video/quicktime", "video/x-matroska" ],
    "TicketMinutes": 30
  },
  "FootballData": {
    "Provider": "futbolasturiano",
    "SyncOnStartup": true,
    "SyncIntervalHours": 6,
    "FutbolAsturiano": {
      "BaseUrl": "https://www.futbolasturiano.es/wp-json/",
      "UserAgent": "TercerTiempo/1.0 (+https://github.com/diegoesp10/TercerTiempo-Back)",
      "Season": "",
      "SeasonStartMonth": 8,
      "SeasonEndMonth": 6,
      "Region": "Asturias",
      "RequestDelayMs": 150,
      "PageSize": 100,
      "TimeZone": "Europe/Madrid",
      "RecoverHiddenEvents": true,
      "HiddenEventPagesPerLeague": 30,
      "HiddenEventRefreshDays": 7,
      "IncludeProfessional": false,
      "IncludeNational": true,
      "IncludeRegional": true,
      "IncludeCups": false,
      "IncludeYouth": false,
      "IncludeLeagueIds": [],
      "ExcludeLeagueIds": []
    },
    "JsonFiles": {
      "Directory": "data/football"
    },
    "BeSoccer": {
      "BaseUrl": "https://apiclient.besoccerapps.com/scripts/api/api.php",
      "ApiKey": "",
      "CompetitionId": "",
      "CompetitionName": "",
      "Level": "Regional",
      "Tier": 1,
      "Group": null,
      "Region": "Asturias",
      "Season": "",
      "SeasonLabel": "",
      "SeasonStartsOn": "2026-09-01",
      "SeasonEndsOn": "2027-06-30"
    }
  }
}
