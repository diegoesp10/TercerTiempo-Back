{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=tercertiempo.db"
  },
  "Jwt": {
    "Issuer": "TercerTiempo",
    "Audience": "TercerTiempo.Web",
    "Key": "",
    "ExpirationMinutes": 720
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "OpenApi": {
    "RoutePrefix": "docs",
    "BasicAuth": {
      "Username": "",
      "Password": ""
    }
  },
  "FootballData": {
    "Provider": "futbolasturiano",
    "SyncOnStartup": true,
    "SyncIntervalHours": 6,
    "FutbolAsturiano": {
      "BaseUrl": "https://www.futbolasturiano.es/wp-json/",
      "UserAgent": "TercerTiempo/1.0 (+https://github.com/diegoesp10/TercerTiempo-Back)",
      "Season": "",
      "SeasonStartMonth": 8,
      "SeasonEndMonth": 6,
      "Region": "Asturias",
      "RequestDelayMs": 150,
      "PageSize": 100,
      "IncludeProfessional": false,
      "IncludeNational": true,
      "IncludeRegional": true,
      "IncludeCups": false,
      "IncludeYouth": false,
      "IncludeLeagueIds": [],
      "ExcludeLeagueIds": []
    },
    "JsonFiles": {
      "Directory": "data/football"
    },
    "BeSoccer": {
      "BaseUrl": "https://apiclient.besoccerapps.com/scripts/api/api.php",
      "ApiKey": "",
      "CompetitionId": "",
      "CompetitionName": "",
      "Level": "Regional",
      "Tier": 1,
      "Group": null,
      "Region": "Asturias",
      "Season": "",
      "SeasonLabel": "",
      "SeasonStartsOn": "2026-09-01",
      "SeasonEndsOn": "2027-06-30"
    }
  }
}
