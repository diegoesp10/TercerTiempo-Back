{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "TercerTiempo",
    "Audience": "TercerTiempo.Web",
    "Key": "",
    "ExpirationMinutes": 720
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "OpenApi": {
    "RoutePrefix": "docs",
    "BasicAuth": {
      "Username": "",
      "Password": ""
    }
  },
  "OfficialSheets": {
    "Enabled": true,
    "Sources": [ "asturfutbol" ],
    "BackgroundScanMinutes": 60,
    "BackgroundBatch": 60,
    "BackgroundStartDelaySeconds": 20,
    "Asturfutbol": {
      "BaseUrl": "https://www.asturfutbol.es/pnfg/NPcd/",
      "UserAgent": "TercerTiempo/1.0 (+https://github.com/diegoesp10/TercerTiempo-Back)",
      "RequestDelayMs": 30000,
      "MaxRequestsPerHour": 20,
      "MaxRequestsPerDay": 60,
      "CacheHours": 24,
      "FailureRetryMinutes": 60,
      "BlockedPauseHours": 24,
      "CalendarCode": "1000120",
      "TeamsCode": "1000119",
      "TimeZone": "Europe/Madrid",
      "MatchLength": 90
    }
  },
  "Throttling": {
    "Enabled": true,
    "WindowSeconds": 60,
    "RequestsPerWindow": 300,
    "RequestsPerEndpointPerWindow": 60,
    "BanMinutes": [ 5, 30, 1440 ],
    "MaxBanMinutes": 43200,
    "StrikeMemoryHours": 168,
    "TrustForwardedHeaders": false,
    "ExemptRoutes": [ "/api/teams/{teamId:guid}/crest", "/api/teams/{teamId:guid}/roster/{entryId:guid}/photo", "/api/players/{playerId:guid}/photo", "/api/squads/{squadId:guid}/video-uploads/{uploadId:guid}/chunks/{index:int}", "/api/videos/{videoId:guid}/stream", "/api/videos/shared/{token}/stream" ]
  },
  "Registration": {
    "ClubInviteRequired": true
  },
  "Admin": {
    "UserName": "diego",
    "Email": "diego@tercertiempo.local",
    "Password": ""
  },
  "Crests": {
    "ClubUploadsOnly": true,
    "Directory": "data/crests",
    "PhotosDirectory": "data/photos"
  },
  "Videos": {
    "Directory": "data/videos",
    "MaxSizeMb": 4096,
    "ChunkSizeMb": 16,
    "UploadExpiryHours": 24,
    "DefaultShareHours": 24,
    "MaxShareHours": 720,
    "DefaultPriceCents": 500,
    "Currency": "EUR",
    "AllowedContentTypes": [ "video/mp4", "video/webm" ],
    "TicketMinutes": 30
  },
  "Licensing": {
    "Currency": "EUR",
    "TrialDays": 30,
    "Provider": "mock",
    "Basic": {
      "MonthlyPriceCents": 990,
      "YearlyPriceCents": 9900,
      "MaxStaff": 1,
      "StripeMonthlyPriceId": "",
      "StripeYearlyPriceId": ""
    },
    "Premium": {
      "MonthlyPriceCents": 1990,
      "YearlyPriceCents": 19900,
      "MaxStaff": 6,
      "StripeMonthlyPriceId": "",
      "StripeYearlyPriceId": ""
    },
    "Stripe": {
      "SecretKey": "",
      "WebhookSecret": "",
      "ApiVersion": "",
      "SuccessUrl": "http://localhost:5173/pago/{CHECKOUT_SESSION_ID}",
      "CancelUrl": "http://localhost:5173/licencias"
    }
  },
  "FootballData": {
    "Provider": "futbolasturiano",
    "SyncIntervalMinutes": 60,
    "FutbolAsturiano": {
      "BaseUrl": "https://www.futbolasturiano.es/wp-json/",
      "UserAgent": "TercerTiempo/1.0 (+https://github.com/diegoesp10/TercerTiempo-Back)",
      "Season": "",
      "SeasonStartMonth": 8,
      "SeasonEndMonth": 6,
      "Region": "Asturias",
      "RequestDelayMs": 150,
      "PageSize": 100,
      "TimeZone": "Europe/Madrid",
      "RecoverHiddenEvents": true,
      "HiddenEventPagesPerLeague": 30,
      "HiddenEventRefreshDays": 7,
      "IncludeProfessional": false,
      "IncludeNational": true,
      "IncludeRegional": true,
      "IncludeCups": false,
      "IncludeYouth": false,
      "IncludeLeagueIds": [],
      "ExcludeLeagueIds": []
    },
    "JsonFiles": {
      "Directory": "data/football"
    }
  }
}
