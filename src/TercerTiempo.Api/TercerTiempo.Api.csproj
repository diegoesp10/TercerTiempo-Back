<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Capa de presentación: Minimal APIs y composición de dependencias; lo común con el servicio de vídeo
       (JWT, errores, límite de llamadas, OpenAPI + Scalar) está en TercerTiempo.Hosting.
       Los endpoints solo hablan con la capa Repository (Application y Domain llegan de forma transitiva). -->

  <PropertyGroup>
    <UserSecretsId>tercer-tiempo-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TercerTiempo.Repository\TercerTiempo.Repository.csproj" />
    <ProjectReference Include="..\TercerTiempo.Hosting\TercerTiempo.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
