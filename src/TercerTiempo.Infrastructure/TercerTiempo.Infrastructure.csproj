<Project Sdk="Microsoft.NET.Sdk">

  <!-- Capa de infraestructura: EF Core (SQL Server), ASP.NET Identity, JWT,
       proveedores de datos de fútbol (scraping/API) y el worker de sincronización. -->

  <ItemGroup>
    <ProjectReference Include="..\TercerTiempo.Application\TercerTiempo.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.5" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <!-- Solo para dotnet-ef con Infrastructure como proyecto de arranque (AppDbContextFactory). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.*" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <!-- Microsoft.Data.SqlClient (vía EF Core SqlServer) arrastra la 9.0.11, con vulnerabilidades conocidas
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7): se fija aquí la versión parcheada de la línea 10.0. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TercerTiempo.Application.Tests" />
  </ItemGroup>

</Project>
