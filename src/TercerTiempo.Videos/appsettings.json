{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "",
    "RealData": ""
  },
  "RealData": {
    "Ingest": false,
    "CopyMinutes": 5,
    "SeedFromThisEnvironment": false
  },
  "Jwt": {
    "Issuer": "TercerTiempo",
    "Audience": "TercerTiempo.Web",
    "Key": "",
    "ExpirationMinutes": 720
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "OpenApi": {
    "RoutePrefix": "docs",
    "BasicAuth": {
      "Username": "",
      "Password": ""
    }
  },
  "Throttling": {
    "Enabled": true,
    "WindowSeconds": 60,
    "RequestsPerWindow": 300,
    "RequestsPerEndpointPerWindow": 60,
    "BanMinutes": [ 5, 30, 1440 ],
    "MaxBanMinutes": 43200,
    "StrikeMemoryHours": 168,
    "TrustForwardedHeaders": false,
    "ExemptRoutes": [ "/media/squads/{squadId:guid}/video-uploads/{uploadId:guid}/chunks/{index:int}", "/media/videos/{videoId:guid}/stream", "/media/videos/{videoId:guid}/download" ]
  },
  "Videos": {
    "Directory": "data/videos",
    "MaxSizeMb": 20480,
    "ChunkSizeMb": 16,
    "UploadExpiryHours": 24,
    "MinFreeSpaceMb": 2048,
    "AllowedContentTypes": [ "video/mp4", "video/webm" ],
    "TicketMinutes": 30,
    "TicketMaxHours": 8
  },
  "VideoProcessing": {
    "Enabled": true,
    "Crf": 22,
    "Preset": "medium",
    "MaxHeight": 1080,
    "AudioKbps": 128,
    "SkipBelowKbps": 4500,
    "MaxAttempts": 2,
    "PollSeconds": 30,
    "TimeoutMinutes": 360,
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe"
  },
  "Passes": {
    "RedeemDays": 30,
    "ClubSharePercent": 60,
    "Currency": "EUR"
  },
  "Licensing": {
    "Provider": "mock"
  },
  "FootballData": {
    "Provider": "futbolasturiano"
  }
}
